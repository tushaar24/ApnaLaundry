 }
+
+// ── Ask (routes/laundry-assistant.js, owner 2026-10-26) ──
+// One row per relay call, so we can see what owners ask: the owner's own words
+// (typed, a chip, or the voice transcript), the assistant's reply text and the
+// names of the tools it called. The shop data the app sends with each question
+// (customers, orders, rates) is NOT stored. LAUNDRY_ASSISTANT_LOG=0 turns it off.
+model LaundryAssistantLog {
+  id            String   @id @default(cuid())
+  laundryUserId String   @map("laundry_user_id")
+  shopId        String   @default("") @map("shop_id") // "" = the main shop
+  kind          String // question | tool_round | nudge | voice
+  question      String? // the owner's words (kind question / voice)
+  reply         String? // the assistant's text back (chat)
+  tools         String? // tool names called, comma-separated
+  status        String   @default("ok") // ok | failed
+  language      String? // voice: the language Sarvam heard
+  appVersion    Int?     @map("app_version")
+  ms            Int?
+  promptTokens  Int?     @map("prompt_tokens")
+  replyTokens   Int?     @map("reply_tokens")
+  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
+
+  @@index([laundryUserId, createdAt(sort: Desc)])
+  @@index([createdAt(sort: Desc)])
+  @@map("laundry_assistant_logs")
+}
