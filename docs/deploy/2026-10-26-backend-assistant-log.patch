+const clip = (s, n) => (s == null ? null : String(s).slice(0, n));
+
+// Saves one row of what was asked (see the top). Fire-and-forget: never awaited by
+// the request, and a failure only logs a warning.
+function saveLog(req, row) {
+  if (process.env.LAUNDRY_ASSISTANT_LOG === '0') return;
+  const v = parseInt(req.get('x-laundry-app-version'), 10);
+  let shopId = '';
+  try { shopId = shops.fromApiId(req.get(shops.HEADER)) || ''; } catch { shopId = ''; }
+  prisma.laundryAssistantLog.create({
+    data: {
+      laundryUserId: req.laundryUserId,
+      shopId: String(shopId),
+      appVersion: Number.isFinite(v) ? v : null,
+      ...row,
+      question: clip(row.question, 4000),
+      reply: clip(row.reply, 4000),
+      tools: clip(row.tools, 500),
+      language: clip(row.language, 20),
+    },
+  }).catch((e) => logger.warn({ err: e && e.message }, 'laundry assistant: log save failed'));
+}
+
+// The owner's words in this call: the last message when it is theirs. The app's own
+// "[App] …" retry note and tool results are not the owner's words.
+function askedIn(messages) {
+  const last = messages[messages.length - 1];
+  if (!last || last.role !== 'user') return { kind: 'tool_round', question: null };
+  const text = String(last.content || '');
+  return text.startsWith('[App]') ? { kind: 'nudge', question: null } : { kind: 'question', question: text };
+}
