 const str = (v, max) => String(v === null || v === undefined ? '' : v).trim().slice(0, max);
 
+// GST rate 0–100 (two decimals) and type: 'excl' (added on top) | 'incl' (already in the price).
+const gstPct = (v) => {
+  const n = Number(v);
