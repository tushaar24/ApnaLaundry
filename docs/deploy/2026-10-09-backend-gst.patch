+-- GST per order (on / rate % / "excl" = added on top, "incl" = already in the
+-- price) and the shop's last-used GST setting (pre-fills every new order).
+-- AlterTable
+ALTER TABLE "laundry_orders" ADD COLUMN     "gst_mode" TEXT NOT NULL DEFAULT 'excl',
+ADD COLUMN     "gst_on" BOOLEAN NOT NULL DEFAULT false,
+ADD COLUMN     "gst_pct" DOUBLE PRECISION NOT NULL DEFAULT 0;
+
+-- AlterTable
+ALTER TABLE "laundry_shops" ADD COLUMN     "gst_mode" TEXT NOT NULL DEFAULT 'excl',
+ADD COLUMN     "gst_on" BOOLEAN NOT NULL DEFAULT false,
+ADD COLUMN     "gst_pct" DOUBLE PRECISION NOT NULL DEFAULT 18;
