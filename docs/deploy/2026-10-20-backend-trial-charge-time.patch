 const TRIAL_DAYS = 7; // trial_2: ₹2 now, first ₹499 plan charge 7 days later
 
+// When a ₹2 trial's first plan charge happens. Razorpay sends the UPI pre-debit
+// notice exactly 24 h before it, and owners cancel AutoPay right after that
+// notice — far more when it lands minutes after the ₹2 (1-day trials: 54% vs 21%
+// on day 6) or in the evening, and debits at 13:00–17:00 succeed most often
+// (cancel readout, 20 Oct 2026). So the charge goes at a fixed IST hour (14:00),
+// never before the promised trial days, and with the notice at least
+// MIN_NOTICE_HOURS (16) after the ₹2 — at 14:00 the day before. A 1-day trial
+// is then charged 40–64 h after the ₹2 (later than promised, never earlier).
+// LAUNDRY_TRIAL_CHARGE_HOUR_IST=off restores "now + trial days".
+const IST_OFFSET_MS = 5.5 * 3600 * 1000;
+const DAY_MS = 24 * 3600 * 1000;
+function trialStartAt(nowMs, days) {
+  const hourSetting = String(env.laundryTrialChargeHourIst ?? '').trim().toLowerCase();
+  if (hourSetting === 'off') return Math.floor(nowMs / 1000) + days * 24 * 3600;
+  const hour = hourSetting === '' || !Number.isInteger(Number(hourSetting)) ? 14 : Math.min(23, Math.max(0, Number(hourSetting)));
+  const minNoticeH = Number.isFinite(parseFloat(env.laundryTrialMinNoticeHours)) ? Math.max(0, parseFloat(env.laundryTrialMinNoticeHours)) : 16;
+  const earliest = nowMs + Math.max(days * DAY_MS, (minNoticeH + 24) * 3600 * 1000);
+  // First `hour`:00 IST at or after `earliest`.
+  const earliestIst = earliest + IST_OFFSET_MS;
+  let atIst = Math.floor(earliestIst / DAY_MS) * DAY_MS + hour * 3600 * 1000;
+  if (atIst < earliestIst) atIst += DAY_MS;
+  return Math.floor((atIst - IST_OFFSET_MS) / 1000);
+}
