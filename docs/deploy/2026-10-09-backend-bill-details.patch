diff -ruN backend-orig/services/laundry-shop-details.js backend-live/services/laundry-shop-details.js
--- backend-orig/services/laundry-shop-details.js	1970-01-01 05:30:00
+++ backend-live/services/laundry-shop-details.js	2026-10-09 11:23:46
@@ -0,0 +1,51 @@
+// Bill details on the laundry shop row (phone on bill, address, GSTIN, UPI,
+// logo, terms, bill design) and onboarding progress. Shared by sync/push and
+// the public bill so both apply the same limits.
+
+const TEMPLATES = ['classic', 'bold', 'receipt'];
+const TERM_IDS = ['check', 'fade', 'pocket', 'days'];
+const STEPS = ['intro', 'name', 'services', 'bill', 'done'];
+
+const str = (v, max) => String(v === null || v === undefined ? '' : v).trim().slice(0, max);
+
+// Sanitisers per synced key. A key a client doesn't send is left untouched, so
+// app builds from before these fields can't wipe them.
+const FIELDS = {
+  billPhone: (v) => str(v, 20).replace(/\D/g, '').slice(-10),
+  address: (v) => str(v, 120).replace(/\s+/g, ' '),
+  gstin: (v) => str(v, 15).toUpperCase().replace(/[^0-9A-Z]/g, ''),
+  upiId: (v) => str(v, 60),
+  logoId: (v) => str(v, 40).replace(/[^A-Za-z0-9_-]/g, ''),
+  terms: (v) => (Array.isArray(v) ? [...new Set(v.map(String))].filter((t) => TERM_IDS.includes(t)) : []),
+  termsCustom: (v) => str(v, 80),
+  billTemplate: (v) => (TEMPLATES.includes(String(v)) ? String(v) : 'classic'),
+  onboardingStep: (v) => (STEPS.includes(String(v)) ? String(v) : ''),
+};
+
+/** The bill-detail keys present in a pushed shop, sanitised. */
+function pickDetails(shop) {
+  const out = {};
+  for (const [key, clean] of Object.entries(FIELDS)) {
+    if (Object.prototype.hasOwnProperty.call(shop, key)) out[key] = clean(shop[key]);
+  }
+  return out;
+}
+
+/** What a printed bill needs from the shop row (null-safe). */
+function billShop(shop) {
+  if (!shop) return { name: '', phone: '' };
+  return {
+    name: shop.name,
+    phone: shop.phone,
+    billPhone: shop.billPhone || '',
+    address: shop.address || '',
+    gstin: shop.gstin || '',
+    upiId: shop.upiId || '',
+    logoId: shop.logoId || '',
+    terms: shop.terms || [],
+    termsCustom: shop.termsCustom || '',
+    billTemplate: shop.billTemplate || 'classic',
+  };
+}
+
+module.exports = { pickDetails, billShop };
