+// POST /api/laundry/shop/logo  { contentType, dataBase64 } -> { logoId }
+// The app resizes the logo (~512px JPEG) before sending. Each upload is a new
+// immutable row; the app then sets shop.logoId and syncs. Older uploads beyond
+// the latest few are pruned.
+const LOGO_TYPES = ['image/jpeg', 'image/png', 'image/webp'];
+const LOGO_MAX_BYTES = 400 * 1024;
+const LOGOS_KEPT = 3;
+
+router.post('/shop/logo', async (req, res, next) => {
+  try {
+    const userId = req.laundryUserId;
+    const contentType = String((req.body && req.body.contentType) || '');
+    const b64 = String((req.body && req.body.dataBase64) || '');
+    if (!LOGO_TYPES.includes(contentType)) {
+      return res.status(400).json({ success: false, message: 'Logo must be a JPEG, PNG or WebP image' });
+    }
+    const data = Buffer.from(b64, 'base64');
+    if (data.length === 0 || data.length > LOGO_MAX_BYTES) {
+      return res.status(400).json({ success: false, message: 'Logo image is empty or too large' });
+    }
+    const id = crypto.randomBytes(12).toString('base64url');
+    await prisma.laundryShopLogo.create({ data: { id, userId, contentType, data } });
+    const old = await prisma.laundryShopLogo.findMany({
+      where: { userId },
+      orderBy: { createdAt: 'desc' },
+      skip: LOGOS_KEPT,
+      select: { id: true },
+    });
+    if (old.length) await prisma.laundryShopLogo.deleteMany({ where: { id: { in: old.map((o) => o.id) } } });
+    return res.json({ success: true, logoId: id });
+  } catch (error) {
+    return next(error);
+  }
+});
