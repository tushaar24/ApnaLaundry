+-- Bill details (phone on bill, address, GSTIN, UPI, logo, terms, design) and
+-- onboarding progress on the shop row, plus a table for uploaded logos.
+-- AlterTable
+ALTER TABLE "laundry_shops" ADD COLUMN     "address" TEXT NOT NULL DEFAULT '',
+ADD COLUMN     "bill_phone" TEXT NOT NULL DEFAULT '',
+ADD COLUMN     "bill_template" TEXT NOT NULL DEFAULT 'classic',
+ADD COLUMN     "gstin" TEXT NOT NULL DEFAULT '',
+ADD COLUMN     "logo_id" TEXT NOT NULL DEFAULT '',
+ADD COLUMN     "onboarding_step" TEXT NOT NULL DEFAULT '',
+ADD COLUMN     "terms" TEXT[] DEFAULT ARRAY[]::TEXT[],
+ADD COLUMN     "terms_custom" TEXT NOT NULL DEFAULT '',
+ADD COLUMN     "upi_id" TEXT NOT NULL DEFAULT '';
+
+-- CreateTable
+CREATE TABLE "laundry_shop_logos" (
+    "id" TEXT NOT NULL,
+    "user_id" TEXT NOT NULL,
+    "content_type" TEXT NOT NULL,
+    "data" BYTEA NOT NULL,
+    "created_at" TIMESTAMPTZ(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+
+    CONSTRAINT "laundry_shop_logos_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateIndex
+CREATE INDEX "laundry_shop_logos_user_id_idx" ON "laundry_shop_logos"("user_id");
+
+-- AddForeignKey
+ALTER TABLE "laundry_shop_logos" ADD CONSTRAINT "laundry_shop_logos_user_id_fkey" FOREIGN KEY ("user_id") REFERENCES "laundry_users"("id") ON DELETE RESTRICT ON UPDATE CASCADE;
