+const SERVICES_SETUP_TEST = 'services_setup_v1';
+const SERVICES_SETUPS = ['samples', 'scratch'];
+const SERVICES_SETUP_MIN_APP = 17;
+
+function servicesSetupStart() {
+  const t = Date.parse(process.env.LAUNDRY_SERVICES_SETUP_START || '');
+  return Number.isFinite(t) ? t : null;
+}
+
+function servicesSetupScratchPct() {
+  const n = parseInt(process.env.LAUNDRY_SERVICES_SETUP_SCRATCH_PCT, 10);
+  return Number.isFinite(n) ? Math.min(100, Math.max(0, n)) : 50;
+}
+
+function servicesSetupForce() {
+  try {
+    const f = JSON.parse(process.env.LAUNDRY_SERVICES_SETUP_FORCE || '{}');
+    return f && typeof f === 'object' ? f : {};
+  } catch {
+    return {};
+  }
+}
+
+// The account's servicesSetup group, or null = not in the test (the old flow).
+function servicesSetupFor(user) {
+  if (!user) return null;
+  const forced = servicesSetupForce()[String(user.phone || '').slice(-10)];
+  if (SERVICES_SETUPS.includes(forced)) return forced;
+  const start = servicesSetupStart();
+  if (start === null) return null;
+  if (user.signupPlatform !== 'android' || !(Number(user.signupAppVersion) >= SERVICES_SETUP_MIN_APP)) return null;
+  if (!(new Date(user.createdAt).getTime() >= start)) return null;
+  return bucket(SERVICES_SETUP_TEST, user.id) < servicesSetupScratchPct() ? 'scratch' : 'samples';
+}
+
