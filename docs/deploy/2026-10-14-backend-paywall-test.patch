diff -ruN pt-orig/services/laundry-paywall-test.js pt-live/services/laundry-paywall-test.js
--- pt-orig/services/laundry-paywall-test.js	1970-01-01 05:30:00
+++ pt-live/services/laundry-paywall-test.js	2026-10-14 11:06:07
@@ -0,0 +1,98 @@
+const crypto = require('crypto');
+
+const clevertap = require('./laundry-clevertap');
+
+// Paywall test (2026-10-14) — BRAND-NEW accounts only.
+//
+// In it: an Android account created at or after LAUNDRY_PAYWALL_TEST_START
+// whose FIRST login came from app 1.0.12+ (laundry_users.signup_app_version ≥ 12,
+// recorded when the account is created). An account that existed before the
+// start, or was created from an older app or the website, is never in it —
+// whatever app it uses later — and keeps exactly what it had. No start set, or
+// no ₹199 plan id, = no test.
+//
+// Split 50/50 by a hash of the user id (`paywall_v1`; LAUNDRY_PAYWALL_TEST_PCT =
+// % in hard_trial, default 50):
+//   hard_trial — the app shows the paywall right after login, no close button:
+//                a 1-day trial (₹2 today, LAUNDRY_TRIAL_AMOUNT_PAISE) then ₹199/month.
+//                0 free orders.
+//   free1      — 1 free order; the app shows the paywall after it and the guide
+//                (finished or skipped). ₹199/month, charged on approval, no trial.
+// Both: Monthly only at ₹199 (LAUNDRY_RAZORPAY_PLAN_MONTHLY_199), the video
+// paywall (LAUNDRY_PAYWALL_VIDEO_URL), the guide always on.
+// CleverTap profile: Paywall_Variant = hard_trial | free1.
+
+const TEST = 'paywall_v1';
+const MIN_APP_VERSION = 12;
+const MONTHLY_199 = { amount: 19900, totalCount: 120 }; // ₹199 × up to 10y
+const TRIAL_DAYS = 1;
+const FREE_ORDERS = { hard_trial: 0, free1: 1 };
+
+const timeFromEnv = (name) => {
+  const t = Date.parse(String(process.env[name] || '').trim());
+  return Number.isFinite(t) ? t : null;
+};
+const START = timeFromEnv('LAUNDRY_PAYWALL_TEST_START');
+// Optional: accounts created from here on are no longer added (existing ones keep their group).
+const END = timeFromEnv('LAUNDRY_PAYWALL_TEST_END');
+const plan199 = () => String(process.env.LAUNDRY_RAZORPAY_PLAN_MONTHLY_199 || '').trim();
+function hardTrialPct() {
+  const n = parseInt(process.env.LAUNDRY_PAYWALL_TEST_PCT, 10);
+  return Number.isFinite(n) ? Math.min(100, Math.max(0, n)) : 50;
+}
+// Per-phone free-order shops (LAUNDRY_FREE_ORDERS_BY_PHONE) are never in a test.
+const OVERRIDE_PHONES = new Set(
+  String(process.env.LAUNDRY_FREE_ORDERS_BY_PHONE || '').split(',').map((p) => p.split(':')[0].trim()).filter(Boolean),
+);
+
+/** The Android app's version code from its header, else 0 (older apps, the website). */
+function appVersion(req) {
+  const n = Number.parseInt(String((req && req.headers && req.headers['x-laundry-app-version']) || '').trim(), 10);
+  return Number.isFinite(n) ? n : 0;
+}
+
+/** 'hard_trial' | 'free1' for an account in the test, else null. Never changes for an account. */
+function groupFor(user) {
+  if (!user || START === null || !plan199()) return null;
+  if (user.signupPlatform !== 'android' || !(Number(user.signupAppVersion) >= MIN_APP_VERSION)) return null;
+  if (OVERRIDE_PHONES.has(String(user.phone || '').slice(-10))) return null;
+  const created = new Date(user.createdAt).getTime();
+  if (!(created >= START) || (END !== null && created >= END)) return null;
+  const bucket = crypto.createHash('sha256').update(`${TEST}:${user.id}`).digest().readUInt32BE(0) % 100;
+  return bucket < hardTrialPct() ? 'hard_trial' : 'free1';
+}
+
+/** What a test account is offered, or null (not in the test → everything as before). */
+function offer(user) {
+  const group = groupFor(user);
+  if (!group) return null;
+  return {
+    group,
+    freeOrders: FREE_ORDERS[group],
+    plan: 'monthly',
+    monthlyAmount: MONTHLY_199.amount,
+    planId: plan199(),
+    totalCount: MONTHLY_199.totalCount,
+    trial: group === 'hard_trial',
+    trialDays: TRIAL_DAYS,
+    videoUrl: String(process.env.LAUNDRY_PAYWALL_VIDEO_URL || '').trim() || null,
+  };
+}
+
+// When each test account was last tagged in CleverTap (uploads can fail silently,
+// so it's re-sent at most once a day per account, and once after a restart).
+const RESEND_MS = 24 * 3600 * 1000;
+const sentAt = new Map();
+
+/** Tags a test account's CleverTap profile with Paywall_Variant. Never throws. */
+function saveToProfile(user) {
+  const group = groupFor(user);
+  if (!group) return;
+  const last = sentAt.get(user.id);
+  if (last && Date.now() - last < RESEND_MS) return;
+  if (sentAt.size > 50000) sentAt.clear();
+  sentAt.set(user.id, Date.now());
+  clevertap.setProfile(user.id, { Paywall_Variant: group }).catch(() => {});
+}
+
+module.exports = { appVersion, groupFor, offer, saveToProfile, TRIAL_DAYS };
