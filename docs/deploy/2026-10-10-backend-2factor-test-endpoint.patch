+// Gate for the 2Factor test routes: hidden (404) unless a secret is set, and
+// the caller must send it in X-Test-Secret.
+function requireTestSecret(req, res, next) {
+  const secret = env.laundryTwoFactorTestSecret;
+  if (!secret) return res.status(404).json({ success: false, message: 'Not found' });
+  const given = Buffer.from(String(req.get('x-test-secret') || ''));
+  const want = Buffer.from(secret);
+  if (given.length !== want.length || !crypto.timingSafeEqual(given, want)) {
+    return res.status(401).json({ success: false, message: 'Bad X-Test-Secret' });
+  }
+  if (!twoFactorTest.configured()) {
+    return res.status(503).json({ success: false, message: 'LAUNDRY_2FACTOR_API_KEY is not set' });
+  }
+  return next();
+}
+
+router.post('/test-2factor/send', publicWriteLimiter, requireTestSecret, async (req, res, next) => {
