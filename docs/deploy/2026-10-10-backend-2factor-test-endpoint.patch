+// Raw 2Factor calls for the secret-gated test endpoint
+// (/api/laundry/auth/test-2factor/*): always 2Factor, whatever
+// LAUNDRY_OTP_PROVIDER says, and the reply is returned as-is for debugging.
+// template: undefined = the configured LAUNDRY_2FACTOR_TEMPLATE, '' = none
+// (2Factor's default OTP), anything else = that template name.
+const twoFactorTest = {
+  configured: () => Boolean(env.laundryTwoFactorApiKey),
+  async send(phone, template) {
+    const name = template === undefined ? (env.laundryTwoFactorTemplate || '') : String(template);
+    const suffix = name ? `/${encodeURIComponent(name)}` : '';
+    const r = await twoFactorProvider.call(`${encodeURIComponent(`+91${phone}`)}/AUTOGEN${suffix}`);
+    return { template: name || null, reply: r };
+  },
+  async verify(phone, code) {
+    const r = await twoFactorProvider.call(`VERIFY3/${encodeURIComponent(`+91${phone}`)}/${encodeURIComponent(code)}`);
+    return { reply: r };
+  },
+};
+
+module.exports = { otpProvider, providerFor, isReviewNumber, twoFactorTest };
