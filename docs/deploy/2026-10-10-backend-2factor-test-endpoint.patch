+    const phone = normalizePhone(req.body?.phone);
+    if (!isValidIndianMobile(phone)) {
+      return res.status(400).json({ success: false, message: 'Enter a valid 10-digit mobile number' });
+    }
+    const template = req.body?.template === undefined || req.body?.template === null
+      ? undefined
+      : String(req.body.template);
+    const result = await twoFactorTest.send(phone, template);
+    req.log.info({ phone: maskPhone(phone), template: result.template, reply: result.reply }, '2factor test send');
+    return res.json({ success: Boolean(result.reply?.ok), phone: `+91${phone}`, ...result });
+  } catch (error) {
+    return next(error);
+  }
+});
+
+router.post('/test-2factor/verify', publicWriteLimiter, requireTestSecret, async (req, res, next) => {
+  try {
+    const phone = normalizePhone(req.body?.phone);
+    const otp = String(req.body?.otp || '');
+    if (!isValidIndianMobile(phone) || !/^[0-9]{4,6}$/.test(otp)) {
+      return res.status(400).json({ success: false, message: 'phone (10 digits) and otp (4-6 digits) are required' });
+    }
+    const result = await twoFactorTest.verify(phone, otp);
+    req.log.info({ phone: maskPhone(phone), reply: result.reply }, '2factor test verify');
+    const matched = Boolean(result.reply?.ok) && /otp matched/i.test(result.reply?.details || '');
+    return res.json({ success: matched, phone: `+91${phone}`, ...result });
   } catch (error) {
     return next(error);
