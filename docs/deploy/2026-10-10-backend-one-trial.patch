 // ──────────────────────────── helpers ────────────────────────────
+
+// The ₹2 trial is once per shop. Any subscription whose mandate was approved
+// (authenticated onwards — including cancelled/halted ones) uses it up; a
+// checkout that was never approved ('created') or was abandoned doesn't.
+async function isTrialEligible(userId) {
+  const used = await prisma.laundrySubscription.count({
+    where: { userId, status: { notIn: ['created', 'abandoned'] } },
+  });
+  return used === 0;
+}
 
