diff -ruN offer-orig/services/laundry-pricing.js offer-live/services/laundry-pricing.js
--- offer-orig/services/laundry-pricing.js	1970-01-01 05:30:00
+++ offer-live/services/laundry-pricing.js	2026-10-14 02:02:21
@@ -0,0 +1,41 @@
+const rzp = require('./laundry-razorpay');
+const offer = require('./laundry-free-orders');
+
+// Which plans a shop is offered (2026-10-14).
+//
+// New shops with the new-user offer (services/laundry-free-orders.js: Android,
+// created since LAUNDRY_NEW_USER_OFFER_START, app 1.0.12+): Monthly only, ₹199,
+// on its own Razorpay plan (LAUNDRY_RAZORPAY_PLAN_MONTHLY_199), with the intro
+// video (LAUNDRY_PAYWALL_VIDEO_URL, optional). Everyone else keeps ₹499
+// Monthly and ₹4,999 Yearly, exactly as before. Until the ₹199 plan id is set,
+// nobody gets Monthly-only. Existing subscriptions keep their plan and price.
+const MONTHLY_199 = { amount: 19900, totalCount: 120 }; // ₹199 × up to 10y
+
+const monthly199PlanId = () => String(process.env.LAUNDRY_RAZORPAY_PLAN_MONTHLY_199 || '').trim();
+
+/** True when this shop, on this app, gets the Monthly-only ₹199 paywall. */
+function monthlyOnly(user, req) {
+  return offer.hasOffer(user, req); // includes "the ₹199 plan id is set"
+}
+
+/** The Monthly price (paise) this shop is shown. */
+function monthlyAmount(user, req) {
+  return monthlyOnly(user, req) ? MONTHLY_199.amount : rzp.amountFor('monthly');
+}
+
+/** The intro video URL for the Monthly-only paywall, or null. */
+function videoUrl(user, req) {
+  if (!monthlyOnly(user, req)) return null;
+  return String(process.env.LAUNDRY_PAYWALL_VIDEO_URL || '').trim() || null;
+}
+
+/** The plan a subscribe request gets: { plan, amount, planId, totalCount }. */
+function planFor(user, req, requested) {
+  if (monthlyOnly(user, req)) {
+    return { plan: 'monthly', amount: MONTHLY_199.amount, planId: monthly199PlanId(), totalCount: MONTHLY_199.totalCount };
+  }
+  const plan = ['monthly', 'annual'].includes(requested) ? requested : 'monthly';
+  return { plan, amount: rzp.amountFor(plan), planId: rzp.planIdFor(plan), totalCount: rzp.totalCountFor(plan) };
+}
+
+module.exports = { monthlyOnly, monthlyAmount, videoUrl, planFor };
