+// MSG91 OTP v5: POST /api/v5/otp?template_id&mobile=91…&otp_length&otp_expiry
+// sends a provider-generated code on the DLT template (the template carries the
+// sender id); GET /api/v5/otp/verify?otp&mobile=91… checks it by phone. The auth
+// key goes in the `authkey` header (never in a logged URL). Replies are
+// {type: 'success'|'error', message, request_id?}; we classify on `message`.
+const MSG91_OTP_BASE = 'https://control.msg91.com/api/v5/otp';
+
+const msg91Provider = {
+  name: 'msg91',
+  async call(method, path, params) {
+    let res;
+    try {
+      res = await fetch(`${MSG91_OTP_BASE}${path}?${new URLSearchParams(params)}`, {
+        method,
+        headers: { authkey: env.laundryMsg91AuthKey, accept: 'application/json', 'content-type': 'application/json' },
+        ...(method === 'POST' ? { body: '{}' } : {}),
+        signal: AbortSignal.timeout(8000),
+      });
+    } catch (err) {
+      logger.error({ err: err.message }, 'msg91 request failed');
+      return null;
+    }
+    let payload = {};
+    try { payload = await res.json(); } catch { /* non-JSON body */ }
+    return {
+      ok: res.ok,
+      httpStatus: res.status,
+      type: String(payload.type || ''),
+      message: String(payload.message || ''),
+      requestId: payload.request_id ? String(payload.request_id) : '',
+    };
+  },
+  async send(phone) {
+    const r = await this.call('POST', '', {
+      template_id: env.laundryMsg91TemplateId,
+      mobile: `91${phone}`,
+      otp_length: '6',
+      otp_expiry: '5', // minutes — the challenge's own expiry (OTP_EXPIRY_MS)
+    });
+    if (!r) return { code: 'unknown' };
+    if (r.type === 'success') return { code: 'sent', reference: r.requestId || 'msg91' };
+    logger.warn({ httpStatus: r.httpStatus, message: r.message }, 'msg91 send rejected');
+    return { code: 'unavailable' };
+  },
+  async verify(phone, code) {
+    const r = await this.call('GET', '/verify', { otp: code, mobile: `91${phone}` });
+    this.lastReply = r;
+    if (!r) return { code: 'unknown' };
+    if (r.type === 'success') return { code: 'valid' };
+    const m = r.message.toLowerCase();
+    if (m.includes('not match') || m.includes('invalid otp') || m.includes('incorrect')) return { code: 'invalid' };
+    // "already verified" = this code was used: same as expired (request a new one).
+    if (m.includes('expired') || m.includes('already verified')) return { code: 'expired' };
+    if (m.includes('max') || m.includes('limit')) return { code: 'limited' };
+    logger.warn({ httpStatus: r.httpStatus, message: r.message }, 'msg91 verify rejected');
+    return { code: 'unknown' };
+  },
+};
+
 // Provider for a (normalized) phone: review numbers always get the local
 // deterministic provider — even with no real provider configured — so QA and
 // app-store review work regardless of SMS setup.
