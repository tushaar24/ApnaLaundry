+// Gate for the MSG91 test routes: the same X-Test-Secret, plus MSG91 creds.
+function requireMsg91Test(req, res, next) {
+  const secret = env.laundryTwoFactorTestSecret;
+  if (!secret) return res.status(404).json({ success: false, message: 'Not found' });
+  const given = Buffer.from(String(req.get('x-test-secret') || ''));
+  const want = Buffer.from(secret);
+  if (given.length !== want.length || !crypto.timingSafeEqual(given, want)) {
+    return res.status(401).json({ success: false, message: 'Bad X-Test-Secret' });
+  }
+  if (!msg91Test.configured()) {
+    return res.status(503).json({ success: false, message: 'LAUNDRY_MSG91_AUTH_KEY / LAUNDRY_MSG91_TEMPLATE_ID not set' });
+  }
+  return next();
