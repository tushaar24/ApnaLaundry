+const CUSTOMER_FLOW_TEST = 'customer_flow_v1';
+const CUSTOMER_FLOWS = ['v1_auto_sheet', 'v2_no_address', 'v3_tap_to_add'];
+const CUSTOMER_FLOW_MIN_APP = 15;
+
+function customerFlowStart() {
+  const t = Date.parse(process.env.LAUNDRY_CUSTOMER_FLOW_START || '');
+  return Number.isFinite(t) ? t : null;
+}
+
+function customerFlowSplit() {
+  const parts = String(process.env.LAUNDRY_CUSTOMER_FLOW_SPLIT || '').split(',').map((x) => parseInt(x, 10));
+  const ok = parts.length === CUSTOMER_FLOWS.length && parts.every((n) => Number.isFinite(n) && n >= 0) && parts.some((n) => n > 0);
+  return ok ? parts : [34, 33, 33];
+}
+
+function customerFlowForce() {
+  try {
+    const f = JSON.parse(process.env.LAUNDRY_CUSTOMER_FLOW_FORCE || '{}');
+    return f && typeof f === 'object' ? f : {};
+  } catch {
+    return {};
+  }
+}
+
+// The account's customerFlow variant, or null = not in the test.
+function customerFlowFor(user) {
+  if (!user) return null;
+  const forced = customerFlowForce()[String(user.phone || '').slice(-10)];
+  if (CUSTOMER_FLOWS.includes(forced)) return forced;
+  const start = customerFlowStart();
+  if (start === null) return null;
+  if (user.signupPlatform !== 'android' || !(Number(user.signupAppVersion) >= CUSTOMER_FLOW_MIN_APP)) return null;
+  if (!(new Date(user.createdAt).getTime() >= start)) return null;
+  const split = customerFlowSplit();
+  const total = split.reduce((a, n) => a + n, 0);
+  let b = (bucket(CUSTOMER_FLOW_TEST, user.id) * total) / 100;
+  for (let i = 0; i < split.length; i++) {
+    if (b < split[i]) return CUSTOMER_FLOWS[i];
+    b -= split[i];
+  }
+  return CUSTOMER_FLOWS[CUSTOMER_FLOWS.length - 1];
+}
+
 function guidePct() {
