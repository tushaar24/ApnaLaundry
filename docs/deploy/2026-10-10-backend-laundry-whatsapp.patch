+-- MyLaundry WhatsApp Business number: webhook log of inbound messages and
+-- delivery/read/failed statuses (routes/laundry-whatsapp.js).
+-- CreateTable
+CREATE TABLE "laundry_whatsapp_messages" (
+    "id" TEXT NOT NULL,
+    "wa_message_id" TEXT,
+    "phone_number_id" TEXT,
+    "laundry_user_id" TEXT,
+    "wa_id" TEXT NOT NULL,
+    "phone" TEXT NOT NULL,
+    "direction" TEXT NOT NULL,
+    "type" TEXT NOT NULL DEFAULT 'text',
+    "body" TEXT,
+    "status" TEXT,
+    "wa_timestamp" TIMESTAMPTZ(6),
+    "error_code" TEXT,
+    "error_title" TEXT,
+    "contact_name" TEXT,
+    "media_id" TEXT,
+    "media_mime" TEXT,
+    "raw" JSONB NOT NULL,
+    "created_at" TIMESTAMPTZ(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+
+    CONSTRAINT "laundry_whatsapp_messages_pkey" PRIMARY KEY ("id")
+);
+
+-- CreateIndex
+CREATE UNIQUE INDEX "laundry_whatsapp_messages_wa_message_id_key" ON "laundry_whatsapp_messages"("wa_message_id");
+
+-- CreateIndex
+CREATE INDEX "laundry_whatsapp_messages_laundry_user_id_idx" ON "laundry_whatsapp_messages"("laundry_user_id");
+
+-- CreateIndex
+CREATE INDEX "laundry_whatsapp_messages_wa_id_created_at_idx" ON "laundry_whatsapp_messages"("wa_id", "created_at" DESC);
+
+-- CreateIndex
+CREATE INDEX "laundry_whatsapp_messages_created_at_idx" ON "laundry_whatsapp_messages"("created_at" DESC);
