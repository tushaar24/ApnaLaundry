+const BILL_CONTACTS_ASK_TEST = 'bill_contacts_ask_v1';
+const BILL_CONTACTS_ASKS = ['ask', 'no_ask'];
+
+function billContactsAskPct() {
+  const n = parseInt(process.env.LAUNDRY_BILL_CONTACTS_ASK_PCT, 10);
+  return Number.isFinite(n) ? Math.min(100, Math.max(0, n)) : 50;
+}
+
+function billContactsAskForce() {
+  try {
+    const f = JSON.parse(process.env.LAUNDRY_BILL_CONTACTS_ASK_FORCE || '{}');
+    return f && typeof f === 'object' ? f : {};
+  } catch {
+    return {};
+  }
+}
+
+// The account's billContactsAsk group: 'ask' | 'no_ask'.
+function billContactsAskFor(user) {
+  if (!user) return 'no_ask';
+  const forced = billContactsAskForce()[String(user.phone || '').slice(-10)];
+  if (BILL_CONTACTS_ASKS.includes(forced)) return forced;
+  return bucket(BILL_CONTACTS_ASK_TEST, user.id) < billContactsAskPct() ? 'ask' : 'no_ask';
+}
