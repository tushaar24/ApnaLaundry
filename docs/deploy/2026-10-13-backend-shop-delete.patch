@@ -0,0 +1,4 @@
+-- Multi-shop: an owner can delete an extra shop (never the main one). Soft:
+-- the shop is hidden and its sync refused; its rows stay. Nullable, so every
+-- existing shop (and every older client) is unaffected.
+ALTER TABLE "laundry_shops" ADD COLUMN "deleted_at" TIMESTAMPTZ(6);
