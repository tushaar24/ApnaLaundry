+// Deleting is soft: the shop leaves the list and its sync is refused (404 on
+// every phone), but its rows stay, so support can bring it back. The main shop
+// can't be deleted — it's the account itself, and what older apps sync.
+router.delete('/:id', async (req, res, next) => {
+  try {
+    const userId = req.laundryUserId;
+    const shopId = shops.fromApiId(req.params.id);
+    if (shopId === shops.MAIN) {
+      return res.status(400).json({ success: false, code: 'MAIN_SHOP', message: "The main shop can't be deleted" });
+    }
+    const { count } = await prisma.laundryShop.updateMany({
+      where: { userId, shopId, deletedAt: null },
+      data: { deletedAt: new Date() },
+    });
+    if (!count) return res.status(404).json({ success: false, code: 'SHOP_NOT_FOUND', message: 'Unknown shop' });
+    req.log.info({ userId, shopId }, 'laundry shop deleted');
+    return res.json({ success: true });
