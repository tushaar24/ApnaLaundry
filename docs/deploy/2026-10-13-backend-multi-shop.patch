+CREATE INDEX "laundry_customers_user_id_shop_id_server_updated_at_idx" ON "laundry_customers"("user_id", "shop_id", "server_updated_at");
+
+ALTER TABLE "laundry_orders" ADD COLUMN "shop_id" TEXT NOT NULL DEFAULT '';
+ALTER TABLE "laundry_orders" DROP CONSTRAINT "laundry_orders_pkey";
+ALTER TABLE "laundry_orders" ADD CONSTRAINT "laundry_orders_pkey" PRIMARY KEY ("user_id", "shop_id", "id");
