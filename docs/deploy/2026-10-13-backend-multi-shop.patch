diff -ruN a/routes/laundry-shops.js b/routes/laundry-shops.js
--- a/routes/laundry-shops.js	1970-01-01 05:30:00
+++ b/routes/laundry-shops.js	2026-10-13 11:16:40
@@ -0,0 +1,74 @@
+const crypto = require('crypto');
+const express = require('express');
+
+const prisma = require('../db');
+const { requireLaundryAuth } = require('../middleware/laundry-auth');
+const shops = require('../services/laundry-shops');
+
+// Multi-shop (2026-10-13, Android 1.0.11+):
+//   GET  /api/laundry/shops          -> { shops: [{ id, name, createdAt }] } — "main" first
+//   POST /api/laundry/shops { name } -> { shop: { id, name, createdAt } } — needs a plan
+//
+// Adding a shop is a paid feature: without a plan the server refuses
+// (403 PLAN_REQUIRED), whatever the app shows. The new shop's details,
+// services, customers and orders then arrive by the usual sync, sent with
+// X-Laundry-Shop: <id> (services/laundry-shops.js).
+
+const router = express.Router();
+router.use(requireLaundryAuth);
+
+// "Unlimited shops" in the app — this only stops a runaway client.
+const MAX_SHOPS = 50;
+
+router.get('/', async (req, res, next) => {
+  try {
+    const rows = await prisma.laundryShop.findMany({
+      where: { userId: req.laundryUserId },
+      select: { shopId: true, name: true, createdAt: true },
+      orderBy: { createdAt: 'asc' },
+    });
+    const main = rows.find((r) => r.shopId === shops.MAIN);
+    // The main shop is listed even before its first sync (name '' — the app has it).
+    const list = [
+      { id: shops.API_MAIN, name: main ? main.name : '', createdAt: main ? main.createdAt : null },
+      ...rows.filter((r) => r.shopId !== shops.MAIN).map((r) => ({ id: r.shopId, name: r.name, createdAt: r.createdAt })),
+    ];
+    return res.json({ success: true, shops: list });
+  } catch (error) {
+    return next(error);
+  }
+});
+
+router.post('/', express.json({ limit: '10kb' }), async (req, res, next) => {
+  try {
+    const userId = req.laundryUserId;
+    const name = String((req.body && req.body.name) || '').trim().replace(/\s+/g, ' ').slice(0, 60);
+    if (!name) return res.status(400).json({ success: false, message: 'Shop name is required' });
+    if (!(await shops.hasPlan(userId))) {
+      return res.status(403).json({ success: false, code: 'PLAN_REQUIRED', message: 'Adding a shop needs a plan' });
+    }
+    if ((await prisma.laundryShop.count({ where: { userId } })) >= MAX_SHOPS) {
+      return res.status(400).json({ success: false, code: 'TOO_MANY_SHOPS', message: 'Too many shops' });
+    }
+    const row = await prisma.laundryShop.create({
+      data: {
+        userId,
+        shopId: crypto.randomUUID(),
+        name,
+        phone: req.laundryAuth.user.phone,
+        closeTime: '',
+        expressPct: 0,
+        nextOrder: 1,
+        nextCust: 1,
+        // 0: the app's first push of this shop's details always wins (last-write-wins).
+        updatedAt: BigInt(0),
+      },
+    });
+    req.log.info({ userId, shopId: row.shopId }, 'laundry shop added');
+    return res.json({ success: true, shop: { id: row.shopId, name: row.name, createdAt: row.createdAt } });
+  } catch (error) {
+    return next(error);
+  }
+});
+
+module.exports = router;
