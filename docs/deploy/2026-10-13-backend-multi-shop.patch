+DROP INDEX "laundry_ledger_user_id_server_updated_at_idx";
+CREATE INDEX "laundry_ledger_user_id_shop_id_server_updated_at_idx" ON "laundry_ledger"("user_id", "shop_id", "server_updated_at");
+
+ALTER TABLE "laundry_day_close" ADD COLUMN "shop_id" TEXT NOT NULL DEFAULT '';
+ALTER TABLE "laundry_day_close" DROP CONSTRAINT "laundry_day_close_pkey";
+ALTER TABLE "laundry_day_close" ADD CONSTRAINT "laundry_day_close_pkey" PRIMARY KEY ("user_id", "shop_id", "date");
+DROP INDEX "laundry_day_close_user_id_server_updated_at_idx";
