diff -ruN a/services/laundry-shops.js b/services/laundry-shops.js
--- a/services/laundry-shops.js	1970-01-01 05:30:00
+++ b/services/laundry-shops.js	2026-10-13 11:16:30
@@ -0,0 +1,60 @@
+const prisma = require('../db');
+const rzp = require('./laundry-razorpay');
+
+// Multi-shop (2026-10-13). An owner's main shop is shop_id '' — every row from
+// before multi-shop. The app names the shop it's working on in the
+// X-Laundry-Shop header; no header (older Android builds, the website) = the
+// main shop, so those clients read and write exactly what they did before.
+// Over the API the main shop's id is "main".
+
+const MAIN = '';
+const API_MAIN = 'main';
+const HEADER = 'x-laundry-shop';
+
+const toApiId = (shopId) => (shopId === MAIN ? API_MAIN : shopId);
+const fromApiId = (id) => {
+  const v = String(id || '').trim();
+  return !v || v === API_MAIN ? MAIN : v;
+};
+
+/**
+ * Router middleware: sets req.laundryShopId from X-Laundry-Shop ('' = main).
+ * An extra shop must exist and belong to the logged-in owner — otherwise 404,
+ * never a quiet fallback to the main shop (that would mix two shops' data).
+ */
+function shopScope(req, res, next) {
+  const shopId = fromApiId(req.get(HEADER));
+  if (shopId === MAIN) {
+    req.laundryShopId = MAIN;
+    return next();
+  }
+  if (shopId.length > 64) {
+    return res.status(400).json({ success: false, code: 'SHOP_NOT_FOUND', message: 'Unknown shop' });
+  }
+  return prisma.laundryShop
+    .findUnique({ where: { userId_shopId: { userId: req.laundryUserId, shopId } }, select: { shopId: true } })
+    .then((row) => {
+      if (!row) return res.status(404).json({ success: false, code: 'SHOP_NOT_FOUND', message: 'Unknown shop' });
+      req.laundryShopId = shopId;
+      return next();
+    })
+    .catch(next);
+}
+
+/**
+ * Whether the owner has a plan now — the same rule as GET /billing/status:
+ * the latest subscription is active, or cancelled but still inside the
+ * period it paid for.
+ */
+async function hasPlan(userId) {
+  const sub = await prisma.laundrySubscription.findFirst({ where: { userId }, orderBy: { createdAt: 'desc' } });
+  if (!sub) return false;
+  if (['authenticated', 'active', 'pending'].includes(sub.status)) return true;
+  if (sub.status !== 'cancelled') return false;
+  const until = (sub.trialAmount || 0) > 0 && (sub.paidCount || 0) === 0
+    ? new Date(sub.createdAt).getTime() + rzp.TRIAL_DAYS * 24 * 3600 * 1000
+    : (sub.currentEnd ? new Date(sub.currentEnd).getTime() : 0);
+  return until > Date.now();
+}
+
+module.exports = { MAIN, API_MAIN, HEADER, toApiId, fromApiId, shopScope, hasPlan };
