--- a/backend/services/laundry-firebase-auth.js	1970-01-01 05:30:00
+++ b/backend/services/laundry-firebase-auth.js	2026-10-11 02:33:40
@@ -0,0 +1,77 @@
+const crypto = require('crypto');
+
+const env = require('../config/env');
+
+// Verifies Firebase Auth ID tokens for the ApnaLaundry login: the app / site
+// runs Firebase phone auth (project env.firebaseProjectId, shweta-makeover),
+// which sends and checks the OTP, then posts the resulting ID token here.
+// Done per Firebase's "verify ID tokens using a third-party JWT library" rules
+// with node's crypto — no firebase-admin, no service account:
+//   header  alg RS256, kid one of Google's securetoken signing keys
+//   payload aud = project id, iss = https://securetoken.google.com/<project>,
+//           exp in the future, iat / auth_time in the past, sub non-empty
+// Resolves to { uid, phone } (phone in E.164, e.g. +919876543210) or throws.
+
+const JWKS_URL = 'https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com';
+const CLOCK_SKEW_S = 300;
+
+let keyCache = { keys: new Map(), expiresAt: 0 };
+
+async function signingKeys() {
+  if (Date.now() < keyCache.expiresAt) return keyCache.keys;
+  const res = await fetch(JWKS_URL, { signal: AbortSignal.timeout(8000) });
+  if (!res.ok) throw new Error(`firebase jwks ${res.status}`);
+  const { keys = [] } = await res.json();
+  const maxAge = Number(/max-age=(\d+)/.exec(res.headers.get('cache-control') || '')?.[1]) || 3600;
+  keyCache = {
+    keys: new Map(keys.map((jwk) => [jwk.kid, crypto.createPublicKey({ key: jwk, format: 'jwk' })])),
+    expiresAt: Date.now() + maxAge * 1000,
+  };
+  return keyCache.keys;
+}
+
+class InvalidFirebaseToken extends Error {}
+
+const b64json = (part) => JSON.parse(Buffer.from(part, 'base64url').toString('utf8'));
+
+async function verifyIdToken(idToken) {
+  const parts = String(idToken || '').split('.');
+  if (parts.length !== 3) throw new InvalidFirebaseToken('malformed token');
+  let header;
+  let payload;
+  try {
+    header = b64json(parts[0]);
+    payload = b64json(parts[1]);
+  } catch {
+    throw new InvalidFirebaseToken('malformed token');
+  }
+  if (header.alg !== 'RS256') throw new InvalidFirebaseToken('bad alg');
+
+  let key = (await signingKeys()).get(header.kid);
+  if (!key) {
+    // Google rotated its keys since the cache was filled.
+    keyCache.expiresAt = 0;
+    key = (await signingKeys()).get(header.kid);
+  }
+  if (!key) throw new InvalidFirebaseToken('unknown kid');
+  const ok = crypto.verify(
+    'RSA-SHA256',
+    Buffer.from(`${parts[0]}.${parts[1]}`),
+    key,
+    Buffer.from(parts[2], 'base64url'),
+  );
+  if (!ok) throw new InvalidFirebaseToken('bad signature');
+
+  const project = env.firebaseProjectId;
+  const now = Math.floor(Date.now() / 1000);
+  if (payload.aud !== project) throw new InvalidFirebaseToken('bad aud');
+  if (payload.iss !== `https://securetoken.google.com/${project}`) throw new InvalidFirebaseToken('bad iss');
+  if (!(payload.exp > now)) throw new InvalidFirebaseToken('expired');
+  if (!(payload.iat <= now + CLOCK_SKEW_S)) throw new InvalidFirebaseToken('bad iat');
+  if (!(payload.auth_time <= now + CLOCK_SKEW_S)) throw new InvalidFirebaseToken('bad auth_time');
+  if (typeof payload.sub !== 'string' || !payload.sub) throw new InvalidFirebaseToken('bad sub');
+  if (typeof payload.phone_number !== 'string') throw new InvalidFirebaseToken('no phone_number');
+  return { uid: payload.sub, phone: payload.phone_number };
+}
+
+module.exports = { verifyIdToken, InvalidFirebaseToken };
