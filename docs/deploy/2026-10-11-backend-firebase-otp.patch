+// Creates or touches the user for a verified phone and returns its permanent token.
+async function loginPhone(tx, phone, now) {
+  // Every query here is a DB round trip on the login critical path, so
+  // create/touch the user in one statement either way.
+  let user = await tx.laundryUser.findUnique({ where: { phone } });
+  const isNewUser = !user;
+  user = isNewUser
+    ? await tx.laundryUser.create({ data: { phone, lastLoginAt: now, apiToken: newToken() } })
+    : await tx.laundryUser.update({ where: { id: user.id }, data: { lastLoginAt: now } });
+  const token = await ensureApiToken(tx, user);
+  return { user, token, isNewUser };
+}
+
+function sendLogin(req, res, result, deviceId) {
+  req.log.info({ userId: result.user.id, deviceId: deviceId.trim() }, 'laundry login verified');
+  laundryMeta.saveSignals(req, result.user); // Meta CAPI match data (website logins)
+  // isNewUser: the account was created just now, so it holds no server data
+  // yet — clients skip their initial pull and go straight to seeding.
+  return res.json({ ...credentialsResponse(result.user, result.token), isNewUser: result.isNewUser });
+}
 
