+// 2factor.in SMS OTP: GET /API/V1/{key}/SMS/{phone}/AUTOGEN[/{template}] sends
+// a provider-generated 6-digit code; GET /API/V1/{key}/SMS/VERIFY3/{phone}/{otp}
+// verifies by phone, so the session id it returns isn't needed. Every reply is
+// {Status, Details}; errors come back as 4xx with Status "Error" and a
+// human-readable Details string, which is what we classify on.
+const TWO_FACTOR_BASE = 'https://2factor.in/API/V1';
+
+const twoFactorProvider = {
+  name: '2factor',
+  async call(path) {
+    let res;
+    try {
+      res = await fetch(`${TWO_FACTOR_BASE}/${encodeURIComponent(env.laundryTwoFactorApiKey)}/SMS/${path}`, {
+        headers: { 'User-Agent': 'ApnaLaundry/1.0' },
+        redirect: 'manual',
+        signal: AbortSignal.timeout(8000),
+      });
+    } catch (err) {
+      // The key is in the URL — log the path only, never the request URL.
+      logger.error({ err: err.message }, '2factor request failed');
+      return null;
+    }
+    let payload = {};
+    try { payload = await res.json(); } catch { /* non-JSON body */ }
+    return { ok: res.ok, status: String(payload.Status || ''), details: String(payload.Details || '') };
+  },
+  async send(phone) {
+    const template = env.laundryTwoFactorTemplate
+      ? `/${encodeURIComponent(env.laundryTwoFactorTemplate)}`
+      : '';
+    const r = await this.call(`${phone}/AUTOGEN${template}`);
+    if (!r) return { code: 'unknown' };
+    if (r.ok && r.status === 'Success' && r.details) return { code: 'sent', reference: r.details };
+    logger.warn({ status: r.status, details: r.details }, '2factor send rejected');
+    return { code: 'unavailable' };
+  },
+  async verify(phone, code) {
+    const r = await this.call(`VERIFY3/${phone}/${encodeURIComponent(code)}`);
+    if (!r) return { code: 'unknown' };
+    const details = r.details.toLowerCase();
+    if (r.ok && details.includes('otp matched')) return { code: 'valid' };
+    if (details.includes('mismatch')) return { code: 'invalid' };
+    if (details.includes('expired')) return { code: 'expired' };
+    logger.warn({ status: r.status, details: r.details }, '2factor verify rejected');
+    return { code: 'unknown' };
+  },
+};
+
 // Provider for a (normalized) phone: review numbers always get the local
 // deterministic provider — even with no real provider configured — so QA and
 // app-store review work regardless of SMS setup.
