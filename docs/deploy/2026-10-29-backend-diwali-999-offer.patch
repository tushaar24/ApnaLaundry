+// A time-boxed price offer for everyone WITHOUT an active plan (first used for the
+// Diwali ₹999/year WhatsApp push, 2026-10-29). While it runs, /billing/status shows
+// its plans and prices and /billing/subscribe charges them — on every client,
+// including older apps and the website, since both read prices from the server.
+// Shops already on an active or authenticated plan are untouched.
+//
+//   LAUNDRY_PAYWALL_OFFER='{"name":"diwali999","from":"2026-10-29T04:30:00Z","until":"2026-10-30T04:30:00Z",
+//     "plans":["annual"],"default":"annual","prices":{"annual":999},"planIds":{"annual":"plan_…"}}'
+//
+// prices in rupees (a plan id is required for every price listed); unset or
+// outside from..until = no offer. Apps 1.0.13+ draw the offer's plan list
+// (yearly only); older apps and the website show both standard plans with the
+// offer price on the one it covers. No ₹2 trial during an offer.
+const { TRIAL_DAYS } = require('./laundry-paywall-test');
+// Apps from this version code draw a server-set plan list (paywall-test CONFIG_MIN_APP_VERSION).
+const CONFIG_MIN_APP_VERSION = 13;
+const rzp = require('./laundry-razorpay');
+
+function current(now = Date.now()) {
+  let o;
+  try {
+    o = JSON.parse(process.env.LAUNDRY_PAYWALL_OFFER || 'null');
+  } catch {
+    return null;
+  }
+  if (!o || typeof o !== 'object' || !o.name) return null;
+  const from = Date.parse(o.from || ''), until = Date.parse(o.until || '');
+  if (!Number.isFinite(from) || !Number.isFinite(until) || now < from || now >= until) return null;
+  const plans = Array.isArray(o.plans) ? o.plans.filter((p) => ['annual', 'monthly'].includes(p)) : [];
+  if (!plans.length) return null;
+  const prices = {}, planIds = {};
+  for (const p of plans) {
+    const rupees = Number(o.prices && o.prices[p]);
+    const id = String((o.planIds && o.planIds[p]) || '').trim();
+    if (!(rupees > 0) || !id) return null; // every offered plan needs a price and a Razorpay plan id
+    prices[p] = Math.round(rupees * 100);
+    planIds[p] = id;
+  }
+  const def = plans.includes(o.default) ? o.default : plans[0];
+  return { name: String(o.name), from, until, plans, default: def, prices, planIds, newAccounts: o.newAccounts === true, audience: o.audience === 'messaged' ? 'messaged' : 'all' };
+}
+
+// audience "messaged": the user ids whose WhatsApp send Meta accepted (laundry_offer_sends),
+// refreshed from the DB at most once a minute. Owners outside it keep the normal paywall.
+// Rows with template 'manual_allow' are owners the owner added by hand: they get the offer
+// whatever their sign-up date (the audience Set carries them in `.forced`).
+let audienceSet = new Set(), audienceAt = 0;
+async function audience(prisma) {
+  const o = current();
+  if (!o || o.audience !== 'messaged') return null;
+  if (Date.now() - audienceAt > 60_000) {
+    try {
+      const rows = await prisma.$queryRawUnsafe('select user_id, template from laundry_offer_sends where wa_message_id is not null and user_id is not null');
+      const set = new Set(rows.map((r) => r.user_id));
+      set.forced = new Set(rows.filter((r) => r.template === 'manual_allow').map((r) => r.user_id));
+      audienceSet = set; audienceAt = Date.now();
+    } catch { /* keep the last set */ }
+  }
+  return audienceSet;
+}
+
+/**
+ * The paywall offer (as paywallTest.offer() shapes it) with the running offer
+ * applied, or [pt] unchanged when there is no offer or the shop already has a
+ * plan. [sub] = the shop's latest subscription row.
+ */
+function apply(pt, sub, clientVersion, fallbackFreeOrders, user, messaged) {
+  const o = current();
+  if (!o) return pt;
+  if (o.audience === 'messaged' && !(messaged && user && messaged.has(user.id))) return pt;
+  if (sub && ['active', 'authenticated'].includes(sub.status)) return pt;
+  // Existing owners only: an account created at/after the offer started keeps the
+  // normal paywall (and its A/B group), unless the offer says newAccounts: true.
+  const forced = Boolean(messaged && messaged.forced && user && messaged.forced.has(user.id));
+  if (!forced && !o.newAccounts && user && user.createdAt && new Date(user.createdAt).getTime() >= o.from) return pt;
+  const base = pt || {
+    group: null, gateGroup: null, config: false, drawn: false, gate: 'first_order',
+    plans: ['annual', 'monthly'], defaultPlan: 'annual', trial: false, trialDays: TRIAL_DAYS,
+    freeOrders: fallbackFreeOrders,
+    prices: { monthly: rzp.amountFor('monthly'), annual: rzp.amountFor('annual') },
+    planIds: { monthly: rzp.planIdFor('monthly'), annual: rzp.planIdFor('annual') },
+    videoUrl: null,
+  };
+  return {
+    ...base,
+    group: `offer:${o.name}`,
+    offer: o.name,
+    config: true,
+    drawn: Number(clientVersion) >= CONFIG_MIN_APP_VERSION,
+    plans: o.plans,
+    defaultPlan: o.default,
+    trial: false,
+    prices: { ...base.prices, ...o.prices },
+    planIds: { ...base.planIds, ...o.planIds },
+  };
+}
+
+module.exports = { current, apply, audience };
