<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Add a customer from the phone's contacts (asked only when the owner taps
         "Choose from contacts"; manual entry works without it). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Push notifications (Android 13+ asks at runtime, once, on Home). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Advertising ID (Android 13+): used by the Meta SDK for Meta ads install /
         subscription attribution. The SDK also merges this in; declared here so
         the Play Console "uses advertising ID" declaration always matches. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- Print tags on a Bluetooth thermal printer (print/TagPrinter). Paired
         printers only, never a scan, so no location. Android 12+ asks for
         "Nearby devices" (BLUETOOTH_CONNECT) the first time Print tags opens;
         older phones grant BLUETOOTH at install. Phones without Bluetooth can
         still install the app. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />

    <!-- Android 11+ package visibility: let the app (and the Razorpay SDK)
         enumerate installed UPI apps so UPI Intent / AutoPay shows in Checkout. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
        <!-- Resolve wa.me https links (Send bill on WhatsApp) on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Send the bill PDF straight into WhatsApp / WhatsApp Business. -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".ApnaLaundryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ApnaLaundry"
        tools:targetApi="31">

        <!-- CleverTap credentials (values from strings.xml; blank = disabled).
             Region is "global" → no CLEVERTAP_REGION meta-data (default data
             centre). Add it back only for a regional account (e.g. eu1/in1). -->
        <meta-data android:name="CLEVERTAP_ACCOUNT_ID" android:value="@string/clevertap_account_id" />
        <meta-data android:name="CLEVERTAP_TOKEN" android:value="@string/clevertap_token" />

        <!-- Meta (Facebook) SDK (values from strings.xml). Auto-init is off so
             nothing is sent while they're blank — MetaEvents.init() turns it on. -->
        <meta-data android:name="com.facebook.sdk.ApplicationId" android:value="@string/facebook_app_id" />
        <meta-data android:name="com.facebook.sdk.ClientToken" android:value="@string/facebook_client_token" />
        <meta-data android:name="com.facebook.sdk.AutoInitEnabled" android:value="false" />

        <!-- Push (FCM): channel / icon / colour for notifications Firebase draws
             itself (app in the background) and for CleverTap campaigns. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="general" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <meta-data android:name="CLEVERTAP_DEFAULT_CHANNEL_ID" android:value="general" />
        <meta-data android:name="CLEVERTAP_NOTIFICATION_ICON" android:value="ic_notification" />

        <!-- Portrait only, everywhere. Android 16 (targetSdk 36) ignores
             screenOrientation on large screens (tablets, foldables, sw >= 600dp)
             unless the app opts out with this property. The opt-out is honoured
             only while targeting 36 — when targetSdk goes to 37 the lock stops
             applying on large screens and the layouts must handle landscape. -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ApnaLaundry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Push deep links: mylaundry://new-order etc. (push/DeepLinks.kt).
                 singleTop so a tap while the app is open reuses this screen. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mylaundry" />
            </intent-filter>
        </activity>

        <!-- Razorpay Checkout (payment screen) follows the app: portrait. It's a
             translucent activity, and Android 8.0 crashes a translucent activity
             that asks for a fixed orientation — "behind" takes MainActivity's. -->
        <activity
            android:name="com.razorpay.CheckoutActivity"
            android:screenOrientation="behind"
            tools:node="merge" />

        <!-- Receives FCM pushes + token refreshes (push/Push.kt). -->
        <service
            android:name=".push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Shares rendered bill PNGs from cacheDir/bills via a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
