<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Add a customer from the phone's contacts (asked only when the owner taps
         "Choose from contacts"; manual entry works without it). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Android 11+ package visibility: let the app (and the Razorpay SDK)
         enumerate installed UPI apps so UPI Intent / AutoPay shows in Checkout. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
        <!-- Resolve wa.me https links (Send bill on WhatsApp) on Android 11+. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Send the bill PDF straight into WhatsApp / WhatsApp Business. -->
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:name=".ApnaLaundryApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ApnaLaundry"
        tools:targetApi="31">

        <!-- CleverTap credentials (values from strings.xml; blank = disabled).
             Region is "global" → no CLEVERTAP_REGION meta-data (default data
             centre). Add it back only for a regional account (e.g. eu1/in1). -->
        <meta-data android:name="CLEVERTAP_ACCOUNT_ID" android:value="@string/clevertap_account_id" />
        <meta-data android:name="CLEVERTAP_TOKEN" android:value="@string/clevertap_token" />

        <!-- Meta (Facebook) SDK (values from strings.xml). Auto-init is off so
             nothing is sent while they're blank — MetaEvents.init() turns it on. -->
        <meta-data android:name="com.facebook.sdk.ApplicationId" android:value="@string/facebook_app_id" />
        <meta-data android:name="com.facebook.sdk.ClientToken" android:value="@string/facebook_client_token" />
        <meta-data android:name="com.facebook.sdk.AutoInitEnabled" android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ApnaLaundry">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares rendered bill PNGs from cacheDir/bills via a content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
