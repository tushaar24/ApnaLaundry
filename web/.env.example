# Copy to .env.local and fill in. .env.local is gitignored.

# Backend the proxy route forwards /api/laundry/* to (server-side, no browser
# Origin header). Local dev: http://localhost:5001 — production: the shared
# courses backend, e.g. https://shwetamakeover.online
BACKEND_URL=https://shwetamakeover.online

# CleverTap Web SDK. Leave the account id BLANK to disable analytics entirely
# (every event no-ops). NEXT_PUBLIC_* is baked at BUILD time — changing it
# needs a rebuild, not just a restart. Region matches the courses org.
NEXT_PUBLIC_CLEVERTAP_ACCOUNT_ID=
NEXT_PUBLIC_CLEVERTAP_REGION=eu1

# Optional: pin "today" to the Android app's demo clock (AppDate.TODAY) so
# dates agree with that client. Remove both for the real system clock.
NEXT_PUBLIC_PINNED_TODAY=2026-09-25
NEXT_PUBLIC_PINNED_NOW_MINUTES=1270
